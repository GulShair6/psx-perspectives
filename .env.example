# Copy to .env; optional .env.local overrides it, inherited variables override both.
# Ollama Cloud takes priority when configured; fixed model gemma4:31b.
OLLAMA_API_KEY=
# Enable YouTube Data API v3 in Google Cloud; server-side key for channel discovery.
YOUTUBE_DATA_API_KEY=
# Optional alternative provider (no automatic fallback).
OPENAI_API_KEY=
# Leave empty to use ./data/research.sqlite
PSX_DB_PATH=

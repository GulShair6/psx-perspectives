{
  "name": "psx-perspectives",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/launch.mjs",
    "dev:web": "next dev --hostname 127.0.0.1",
    "worker": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/worker.ts",
    "build": "next build",
    "start": "node scripts/launch.mjs --production",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "proof": "tsx scripts/proof.ts",
    "refresh": "tsx scripts/refresh.ts",
    "backup": "tsx scripts/backup.ts",
    "repair": "node --import tsx scripts/repair.ts",
    "test:browser": "tsx scripts/browser-check.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "cheerio": "^1.1.2",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "openai": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "youtube-transcript": "1.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "type": "module",
  "description": "A local, source-grounded research workspace for Pakistan Stock Exchange commentary.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  }
}
